# ─────────────────────────────────────────────────────────────────────────────
#  Dockerfile.dev — Development variant
#
#  Extends the production image with:
#    - Jupyter Lab
#    - ipython, ipdb
#    - pytest + coverage
#    - Full repo volume-mounted (no COPY, edited live on host)
# ─────────────────────────────────────────────────────────────────────────────

FROM nvcr.io/nvidia/pytorch:26.03-py3

RUN apt-get update && apt-get install -y --no-install-recommends \
    portaudio19-dev \
    libsndfile1 \
    ffmpeg \
    git \
    cmake \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir \
    openai-whisper==20240930 \
    onnxruntime==1.20.1 \
    pyaudio==0.2.14 \
    psutil==5.9.8 \
    PyYAML \
    rich==13.7.1 \
    jupyterlab==4.2.3 \
    ipython==8.25.0 \
    ipdb==0.13.13 \
    pytest==8.2.2 \
    pytest-cov==5.0.0 \
    black==24.4.2 \
    isort==5.13.2 \
    flake8==7.0.0

RUN git clone https://github.com/NVIDIA-AI-IOT/torch2trt /opt/torch2trt \
    && cd /opt/torch2trt \
    && git checkout 4e820ae31b4e35d59685935223b05b2e11d47b03 \
    && python3 setup.py install

RUN git clone https://github.com/NVIDIA-AI-IOT/whisper_trt /opt/whisper_trt \
    && cd /opt/whisper_trt \
    && git checkout 268eff10a1e38118a2734745b9db14f7419a08a5 \
    && pip3 install --no-cache-dir .

# Jupyter port
EXPOSE 8888

# Dev default: bash shell (docker-compose overrides this)
CMD ["/bin/bash"]
